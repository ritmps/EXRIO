Cell[CellGroupData[{

Cell["EXRIO", "GuideTitle",ExpressionUUID->"859f1ca1-c791-41b0-a0c7-8845c9ca71e2"],

Cell["\<\
High-performance Wolfram Language paclet for multi-channel OpenEXR I/O, \
ad-hoc computed passes, Cryptomatte object segmentation, and screen-space \
differential geometry.\
\>", "GuideAbstract",ExpressionUUID->"7df1fe5a-5f87-4979-bb2f-68dd33a3385c"]
}, Open  ]],

