Cell["Basic Examples", "ExampleSection",ExpressionUUID->"e83190f3-65de-4af6-a23f-b9596714396d"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<EXRIO`\>\"", "]"}]], "Input",ExpressionUUID->"d07cd5b2-9c50-4dcc-b5b7-3a10f4e8f940"],

Cell["\<\
Attach an ad-hoc scalar pass in pipeline operator form (auto-infers \
\"Scalar\" type):\
\>", "ExampleText",ExpressionUUID->"4a817be5-1637-4e19-aad7-d9c5925e1843"],

Cell[BoxData[
 RowBox[{"exr", " ", "=", " ", 
  RowBox[{
   RowBox[{"ReadEXR", "[", 
    RowBox[{"\"\<scene_001_view_000.exr\>\"", ",", " ", 
     RowBox[{"\"\<ComputeDerivedPasses\>\"", " ", "->", " ", "False"}]}], 
    "]"}], " ", "//", "\n", "  ", 
   RowBox[{"AddComputedPass", "[", 
    RowBox[{"\"\<AlbedoMean\>\"", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"#", "[", 
            RowBox[{"\"\<Data\>\"", ",", " ", "\"\<albedo\>\""}], "]"}], 
           "]"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}], " ", "/", " ", "3.0"}], " ", 
       "&"}], ")"}]}], "]"}]}]}]], "Input",ExpressionUUID->"6d29b62e-b20f-\
475d-a5ee-a067797f93b6"],

Cell["Attach a 3-channel vector pass explicitly:", "ExampleText",ExpressionUUID->"612521e4-466c-4513-906c-6a0ac80bb00f"],

Cell[BoxData[
 RowBox[{"exr", " ", "=", " ", 
  RowBox[{"AddComputedPass", "[", 
   RowBox[{"exr", ",", " ", "\"\<FlippedNormals\>\"", ",", " ", 
    RowBox[{"-", 
     RowBox[{"Normal", "[", 
      RowBox[{"exr", "[", 
       RowBox[{"\"\<Data\>\"", ",", " ", "\"\<Nn\>\""}], "]"}], "]"}]}], ",", 
    " ", 
    RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Vector3\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"50ed8b20-67e0-4143-9f3e-d407fe57dac8"],

Cell["Query the ad-hoc pass like any built-in pass:", "ExampleText",ExpressionUUID->"7b1bb1c2-d949-4e13-a4ab-501bec9625bc"],

Cell[BoxData[
 RowBox[{"exr", "[", "\"\<AlbedoMean\>\"", "]"}]], "Input",ExpressionUUID->"ab512e3a-2201-4301-8e0c-ce4afb406f8f"]
}, Open  ]]
}, Open  ]],

