Cell["AddComputedPass", "ObjectName",ExpressionUUID->"63d5fdb9-97b0-4565-a2db-2ab1314edd33"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5be78878-39ac-4632-a7c1-ed60dbcb1195"],
 Cell[BoxData[
  RowBox[{"AddComputedPass", "[", 
   RowBox[{
    StyleBox["exr", "TI"], ",", 
    StyleBox["name", "TI"], ",", 
    StyleBox["arrayOrFn", "TI"], ",", 
    StyleBox["opts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "099f8196-aa0b-451b-9ad8-f1439f9f21fc"],
 " \[LineSeparator]stores an ad-hoc computed pass under \"Computed\"[name] in \
an EXRData container.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"aca38c33-d48a-4806-9eaf-92868dc83ffa"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"AddComputedPass", "[", 
    RowBox[{
     RowBox[{
      StyleBox["name", "TI"], " ", "\[Rule]", " ", 
      StyleBox["fn", "TI"]}], ",", 
     StyleBox["opts", "TI"]}], "]"}], "[", 
   StyleBox["exr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "39b3807e-7679-4c77-b61e-d9c186e0f748"],
 " \[LineSeparator]is the operator form for pipeline composition."
}], "Usage",ExpressionUUID->"6a72f1c5-4ccb-4c49-ae2d-783442c4954a"],

