Cell[CellGroupData[{

Cell["ComputeEcologicalCues", "ObjectName",ExpressionUUID->"274091fa-887e-462e-8fc4-9ecab0b2291e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5a8bce0-6d17-4ca7-9d31-422ac8d8161d"],
 Cell[BoxData[
  RowBox[{"ComputeEcologicalCues", "[", 
   StyleBox["exr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2dab7db9-67a2-4c08-bcf6-c351cc7e1887"],
 " \[LineSeparator]derives Decomp v3 Gibsonian cue passes from camera-space \
geometry.P and geometry.Nn (no re-render needed): LogDepth (ordinal-ranking \
proxy, never supervised metrically), Contour (occluding edge owned by the \
near/figure side), TextureGradient (grad ln of optical texture density, \
compressed to the unit disk), TexValid (mask excluding depth \
discontinuities), Occlusion (screen-space horizon AO accessibility, 1 = open) \
and RimSign (Koenderink contour-convexity sign on owned contours: +1 \
convex/elliptic, -1 concave/hyperbolic, 0 inflection or off-contour).",
 "\n"
}], "Usage",ExpressionUUID->"b881b4f0-8a7b-4a43-bd29-78f3bf27119d"],

