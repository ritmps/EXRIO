 "Metadata" -> <|
   "context" -> "EXRComputed`", "type" -> "Symbol", "paclet" -> "EXRIO", 
    "language" -> "en", "title" -> "ComputeEcologicalCues", "windowtitle" -> 
    "ComputeEcologicalCues", "uri" -> "EXRIO/ref/ComputeEcologicalCues", 
    "summary" -> 
    "ComputeEcologicalCues[exr] derives Decomp v3 Gibsonian cue passes from \
camera-space geometry.P and geometry.Nn (no re-render needed): LogDepth \
(ordinal-ranking proxy, never supervised metrically), Contour (occluding edge \
owned by the near/figure side), TextureGradient (grad ln of optical texture \
density, compressed to the unit disk), TexValid (mask excluding depth \
discontinuities), Occlusion (screen-space horizon AO accessibility, 1 = open) \
and RimSign (Koenderink contour-convexity sign on owned contours: +1 \
convex/elliptic, -1 concave/hyperbolic, 0 inflection or off-contour).", 
    "index" -> True|>|>,
FrontEndVersion->"15.0 for Linux x86 (64-bit) (July 3, 2026)",
