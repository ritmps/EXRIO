Cell["ComputeEcologicalCues", "ObjectName",ExpressionUUID->"274091fa-887e-462e-8fc4-9ecab0b2291e"],

Cell[BoxData[
 RowBox[{
  StyleBox["ComputeEcologicalCues", "UsageSymbol"], " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ComputeEcologicalCues", "[", "exr", "]"}], " ", "derives", " ",
       "Decomp", " ", "v3", " ", "Gibsonian", " ", "cue", " ", "passes", " ", 
      "from", " ", "camera"}], "-", 
     RowBox[{"space", " ", 
      RowBox[{"geometry", ".", "P"}], " ", "and", " ", 
      RowBox[{"geometry", ".", "Nn"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"no", " ", "re"}], "-", 
        RowBox[{"render", " ", "needed"}]}], ")"}]}]}], ":", " ", 
    RowBox[{"LogDepth", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ordinal", "-", 
        RowBox[{"ranking", " ", "proxy"}]}], ",", " ", 
       RowBox[{"never", " ", "supervised", " ", "metrically"}]}], ")"}]}]}], ",",
    " ", 
   RowBox[{"Contour", " ", 
    RowBox[{"(", 
     RowBox[{"occluding", " ", "edge", " ", "owned", " ", "by", " ", "the", " ", 
      RowBox[{"near", "/", "figure"}], " ", "side"}], ")"}]}], ",", " ", 
   RowBox[{"TextureGradient", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      "grad", " ", "ln", " ", "of", " ", "optical", " ", "texture", " ", 
       "density"}], ",", " ", 
      RowBox[{
      "compressed", " ", "to", " ", "the", " ", "unit", " ", "disk"}]}], 
     ")"}]}], ",", " ", 
   RowBox[{"TexValid", " ", 
    RowBox[{"(", 
     RowBox[{"mask", " ", "excluding", " ", "depth", " ", "discontinuities"}],
      ")"}]}], ",", " ", 
   RowBox[{"Occlusion", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"screen", "-", 
       RowBox[{"space", " ", "horizon", " ", "AO", " ", "accessibility"}]}], ",",
       " ", 
      RowBox[{"1", " ", "=", " ", "open"}]}], ")"}], " ", "and", " ", 
    "RimSign", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Koenderink", " ", "contour"}], "-", 
        RowBox[{"convexity", " ", "sign", " ", "on", " ", "owned", " ", 
         RowBox[{"contours", ":", " ", 
          RowBox[{
           RowBox[{"+", "1"}], " ", 
           RowBox[{"convex", "/", "elliptic"}]}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "1"}], " ", 
        RowBox[{"concave", "/", "hyperbolic"}]}], ",", " ", 
       RowBox[{
        RowBox[{"0", " ", "inflection", " ", "or", " ", "off"}], "-", 
        "contour"}]}], ")"}], "."}]}]}]}]], "Usage",ExpressionUUID->"7df1ea88-\
49f7-4778-8eab-6d3ab3fcf4e1"],

