Cell[CellGroupData[{

Cell["ComputeScaleSpaceCurvature", "ObjectName",ExpressionUUID->"1398c0ac-499c-48dd-bbff-c790f428c54a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c1ad1e0c-5fa8-4a49-93c3-d7dfe90add85"],
 Cell[BoxData[
  RowBox[{"ComputeScaleSpaceCurvature", "[", 
   RowBox[{
    StyleBox["exr", "TI"], ",", 
    StyleBox["sigma", "TI"], ",", 
    StyleBox["opts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3568cbe8-bb54-4ac7-b334-a13d4f2e1ad4"],
 " \[LineSeparator]computes Koenderink scale-space / local-jet differential \
invariants (ShapeIndex, LogCurvedness, ScaleNormalizedCurvedness, k1, k2, H, \
K, KoenderinkCategory) at spatial aperture sigma (in pixels, or list of \
scales {s1, s2, ...}), using either \"Method\" -> \"WeingartenJet\" (3D \
manifold 1-jet on P and Nn) or \"Method\" -> \"MongeJet\" (2D Gaussian 2-jet \
J^2_sigma on depth Z).",
 "\n"
}], "Usage",ExpressionUUID->"77b114d0-2647-4997-801d-a7c72407e9d5"],

