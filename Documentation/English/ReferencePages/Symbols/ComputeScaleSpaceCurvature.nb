Cell[BoxData[
 RowBox[{
  StyleBox["ComputeScaleSpaceCurvature", "UsageSymbol"], " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ComputeScaleSpaceCurvature", "[", 
      RowBox[{"exr", ",", " ", "sigma", ",", " ", "opts"}], "]"}], " ", 
     "computes", " ", "Koenderink", " ", "scale"}], "-", 
    RowBox[{"space", " ", "/", " ", "local"}], "-", 
    RowBox[{"jet", " ", "differential", " ", "invariants", " ", 
     RowBox[{"(", 
      RowBox[{
      "ShapeIndex", ",", " ", "LogCurvedness", ",", " ", 
       "ScaleNormalizedCurvedness", ",", " ", "k1", ",", " ", "k2", ",", " ", 
       "H", ",", " ", "K", ",", " ", "KoenderinkCategory"}], ")"}], " ", "at",
      " ", "spatial", " ", "aperture", " ", "sigma", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"in", " ", "pixels"}], ",", " ", 
       RowBox[{"or", " ", "list", " ", "of", " ", "scales", " ", 
        RowBox[{"{", 
         RowBox[{"s1", ",", " ", "s2", ",", " ", "..."}], "}"}]}]}], 
      ")"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"using", " ", "either", " ", "\"\<Method\>\""}], " ", "->", " ", 
    RowBox[{
     RowBox[{"\"\<WeingartenJet\>\"", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "D", " ", "manifold", " ", "1"}], "-", 
        RowBox[{"jet", " ", "on", " ", "P", " ", "and", " ", "Nn"}]}], ")"}], 
      " ", "or", " ", "\"\<Method\>\""}], " ", "->", " ", 
     RowBox[{"\"\<MongeJet\>\"", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "D", " ", "Gaussian", " ", "2"}], "-", 
         RowBox[{"jet", " ", 
          RowBox[{"J", "^", "2"}], "_sigma", " ", "on", " ", "depth", " ", 
          "Z"}]}], ")"}], "."}]}]}]}]}]}]], "Usage",ExpressionUUID->"108cca8e-\
c76e-4d65-a6c9-9a8cb9ccb5ad"],

