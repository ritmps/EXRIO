Cell[CellGroupData[{

Cell["EXRIO", "GuideTitle",ExpressionUUID->"edcf3fd8-46fd-4ff4-ba69-c1cc6974cf90"],

Cell["\<\
High-performance Wolfram Language paclet for multi-channel OpenEXR I/O, \
ad-hoc computed passes, Cryptomatte object segmentation, and screen-space \
differential geometry.\
\>", "GuideAbstract",ExpressionUUID->"5a1b03bd-abe8-4a0f-8b6a-2b64d964667b"],

Cell["\t", "GuideDelimiterSubsection",ExpressionUUID->"666d4250-2627-4808-b57b-b2738911eee2"]
}, Open  ]],

