Cell["\<\
Attach an ad-hoc scalar pass in pipeline operator form (auto-infers \
\"Scalar\" type):\
\>", "ExampleText",ExpressionUUID->"4b4df2a5-4975-4c30-a988-c488b37d270f"],

Cell[BoxData[
 RowBox[{"exr", " ", "=", " ", 
  RowBox[{
   RowBox[{"ReadEXR", "[", 
    RowBox[{"\"\<scene_001_view_000.exr\>\"", ",", " ", 
     RowBox[{"\"\<ComputeDerivedPasses\>\"", " ", "->", " ", "False"}]}], 
    "]"}], " ", "//", "\n", "  ", 
   RowBox[{"AddComputedPass", "[", 
    RowBox[{"\"\<AlbedoMean\>\"", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"#", "[", 
            RowBox[{"\"\<Data\>\"", ",", " ", "\"\<albedo\>\""}], "]"}], 
           "]"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}], " ", "/", " ", "3.0"}], " ", 
       "&"}], ")"}]}], "]"}]}]}]], "Input",ExpressionUUID->"cf0f3f18-3402-\
4944-a1b7-046d8c64dda5"],

Cell["Attach a 3-channel vector pass explicitly:", "ExampleText",ExpressionUUID->"8540a969-29e9-476f-940c-98bdb6b79e91"],

Cell[BoxData[
 RowBox[{"exr", " ", "=", " ", 
  RowBox[{"AddComputedPass", "[", 
   RowBox[{"exr", ",", " ", "\"\<FlippedNormals\>\"", ",", " ", 
    RowBox[{"-", 
     RowBox[{"Normal", "[", 
      RowBox[{"exr", "[", 
       RowBox[{"\"\<Data\>\"", ",", " ", "\"\<Nn\>\""}], "]"}], "]"}]}], ",", 
    " ", 
    RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Vector3\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"21bc8130-9d35-4bd2-b000-9a75001b2b97"],

Cell["Query the ad-hoc pass like any built-in pass:", "ExampleText",ExpressionUUID->"85c6d941-c7bc-4379-8ba8-e861ae32b7f2"],

Cell[BoxData[
 RowBox[{"exr", "[", "\"\<AlbedoMean\>\"", "]"}]], "Input",ExpressionUUID->"e58a845b-2adb-4a62-b837-ac53f672ffef"]
}, Closed]]
