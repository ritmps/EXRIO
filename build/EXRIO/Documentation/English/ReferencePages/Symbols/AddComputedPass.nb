Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<EXRIO`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"d835d8bd-8f48-4e16-9423-87d863b2fc1b"],

Cell["\<\
Attach an ad-hoc scalar pass in pipeline operator form (auto-infers \
\"Scalar\" type):\
\>", "ExampleText",ExpressionUUID->"93b4dcbe-3509-4b85-b740-7567e16262fb"],

Cell[BoxData[
 RowBox[{"exr", " ", "=", " ", 
  RowBox[{
   RowBox[{"ReadEXR", "[", 
    RowBox[{"\"\<scene_001_view_000.exr\>\"", ",", " ", 
     RowBox[{"\"\<ComputeDerivedPasses\>\"", " ", "->", " ", "False"}]}], 
    "]"}], " ", "//", "\n", "  ", 
   RowBox[{"AddComputedPass", "[", 
    RowBox[{"\"\<AlbedoMean\>\"", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"#", "[", 
            RowBox[{"\"\<Data\>\"", ",", " ", "\"\<albedo\>\""}], "]"}], 
           "]"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}], " ", "/", " ", "3.0"}], " ", 
       "&"}], ")"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"d8942afd-b3be-4fc7-94c8-3bb7c5c3aace"],

Cell["Attach a 3-channel vector pass explicitly:", "ExampleText",ExpressionUUID->"2beeeb71-b105-4e14-8402-f4f69dca4c5c"],

Cell[BoxData[
 RowBox[{"exr", " ", "=", " ", 
  RowBox[{"AddComputedPass", "[", 
   RowBox[{"exr", ",", " ", "\"\<FlippedNormals\>\"", ",", " ", 
    RowBox[{"-", 
     RowBox[{"Normal", "[", 
      RowBox[{"exr", "[", 
       RowBox[{"\"\<Data\>\"", ",", " ", "\"\<Nn\>\""}], "]"}], "]"}]}], ",", 
    " ", 
    RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Vector3\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"96f61b1b-2f8a-4ad8-a682-e7df7bb5d2d7"],

Cell["Query the ad-hoc pass like any built-in pass:", "ExampleText",ExpressionUUID->"e4bb641e-a41b-40e0-9e75-43c6cf5d1ab0"],

Cell[BoxData[
 RowBox[{"exr", "[", "\"\<AlbedoMean\>\"", "]"}]], "Input",
