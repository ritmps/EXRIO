Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{"ComputeScaleSpaceCurvature", "[", 
       RowBox[{
        StyleBox["exr", "TI"], ",", 
        StyleBox["sigma", "TI"], ",", 
        StyleBox["opts", "TI"]}], "]"}]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "050065d1-aef5-4b48-a3b1-d5aa21ab7676"],
     " \[LineSeparator]computes Koenderink scale-space / local-jet \
differential invariants (ShapeIndex, LogCurvedness, \
ScaleNormalizedCurvedness, k1, k2, H, K, KoenderinkCategory) at spatial \
aperture sigma (in pixels, or list of scales {s1, s2, ...}), using either \
\"Method\" -> \"WeingartenJet\" (3D manifold 1-jet on P and Nn) or \"Method\" \
-> \"MongeJet\" (2D Gaussian 2-jet J^2_sigma on depth Z)."
    }],ExpressionUUID->"c73040e4-7631-4933-93fb-7f15375cbbc1"]}
  }]], "Usage",ExpressionUUID->"b5a03e28-0f34-42ae-8e4f-ff055436c278"]
}, Open  ]],

